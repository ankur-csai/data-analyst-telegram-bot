# Copy to .env for local dev. Never commit the real .env (already gitignored).

# From @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# platform.openai.com API key
OPENAI_API_KEY=

# GitHub personal access token (classic, "repo" scope, or fine-grained with
# "Contents: read and write" on this repo) - used to push logs/run.jsonl via
# the Contents API so the raw URL stays public and up to date.
GH_TOKEN=

# owner/repo, e.g. octocat/data-analyst-telegram-bot
GITHUB_REPO=

# Optional: override the OpenAI model (defaults to gpt-4o)
OPENAI_MODEL=
